#. type: Content of: <book><appendix><title>
#: doc/index.docbook:556
msgid "Installation"
msgstr "Installatie"

#. type: Content of: <book><appendix><para>
#: doc/index.docbook:558
msgid ""
"&kappname; is built with CMake. It needs Qt 6.7 or newer, KDE Frameworks 6, "
"zint, CUPS and libudev; the handbook needs KDocTools. <filename>INSTALL.md</"
"filename> in the source lists every requirement, the packages for common "
"distributions, the build options and how to set up each kind of printer."
msgstr ""
"&kappname; wordt gebouwd met CMake. Het heeft Qt 6.7 of nieuwer, KDE "
"Frameworks 6, zint, CUPS en libudev nodig; het handboek heeft KDocTools "
"nodig. <filename>INSTALL.md</filename> in de broncode noemt alle vereisten, "
"de pakketten voor veelgebruikte distributies, de bouwopties en hoe u elk "
"soort printer instelt."

#. type: Content of: <book><appendix><programlisting>
#: doc/index.docbook:560
#, no-wrap
msgid ""
"cmake -S . -B build -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_INSTALL_PREFIX=/usr\n"
"cmake --build build\n"
"cmake --install build"
msgstr ""
"cmake -S . -B build -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_INSTALL_PREFIX=/usr\n"
"cmake --build build\n"
"cmake --install build"

