#. type: Content of: <book><chapter><title>
#: doc/index.docbook:508
msgid "Command-Line Tools and Add-ons"
msgstr ""

#. type: Content of: <book><chapter><sect1><title>
#: doc/index.docbook:511
msgid "plasma-label-creator-render"
msgstr ""

#. type: Content of: <book><chapter><sect1><para>
#: doc/index.docbook:513
msgid ""
"<command>plasma-label-creator-render</command> renders a label to a PNG or "
"PDF file, prints it, or shows what a printer would receive. For example:"
msgstr ""

#. type: Content of: <book><chapter><sect1><programlisting>
#: doc/index.docbook:515
#, no-wrap
msgid ""
"# Render a label to an image, and list what is on it\n"
"plasma-label-creator-render --info label.label preview.png\n"
"\n"
"# Print it on a CUPS queue\n"
"plasma-label-creator-render label.label --send DYMO-LabelWriter-450\n"
"\n"
"# Ask a ZPL printer on the network what it is and what is loaded\n"
"plasma-label-creator-render --zpl-info 192.0.2.10\n"
"\n"
"# A PDF proof with the label's outline\n"
"plasma-label-creator-render --outline label.label proof.pdf"
msgstr ""

#. type: Content of: <book><chapter><sect1><para>
#: doc/index.docbook:527
msgid ""
"<userinput><command>plasma-label-creator-render</command> "
"<option>--help</option></userinput> lists every option."
msgstr ""

#. type: Content of: <book><chapter><sect1><title>
#: doc/index.docbook:531
msgid "Add-ons"
msgstr ""

#. type: Content of: <book><chapter><sect1><para>
#: doc/index.docbook:533
msgid ""
"&kappname; needs no add-ons. An add-on can put actions in the "
"<guimenu>File</guimenu> menu and a status indicator in the status bar, and "
"open labels it keeps in a folder of its own, such as a team's labels kept on "
"a server. Add-ons found on the computer are on until they are switched off "
"on the <guilabel>Add-ons</guilabel> page of the settings."
msgstr ""

