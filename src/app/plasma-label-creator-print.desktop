[Desktop Entry]
Type=Application
Name=Label Printing
GenericName=Label Printing
Comment=Choose a label, fill in its form and print it, without editing
Exec=plasma-label-creator --print-only %F
Icon=document-print-direct
Terminal=false
Categories=Qt;KDE;Office;
