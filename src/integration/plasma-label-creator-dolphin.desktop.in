#
# Dolphin's right-click menu for label files (switched off in Dolphin's
# Settings > Context Menu like any other).
[Desktop Entry]
Type=Service
MimeType=application/x-dymo-label;
Actions=printLabel;
X-KDE-Priority=TopLevel

[Desktop Action printLabel]
Name=Print Label…
Icon=@PRINT_ICON@
Exec=@KDE_INSTALL_FULL_BINDIR@/plasma-label-creator --print-only %f
