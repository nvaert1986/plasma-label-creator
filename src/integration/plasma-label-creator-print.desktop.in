[Desktop Entry]
Type=Application
Name=Label Printing
GenericName=Label Printing
Comment=Choose a label, fill in its form and print it, without editing
Exec=@KDE_INSTALL_FULL_BINDIR@/plasma-label-creator --print-only %F
Icon=@PRINT_ICON@
Terminal=false
Categories=Qt;KDE;Office;
@PRINT_LAUNCHER_EXTRAS@
