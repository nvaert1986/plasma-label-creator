[Unit]
Description=Plasma Label Creator automation service
Documentation=https://github.com/nvaert1986/plasma-label-creator
After=cups.service

[Service]
ExecStart=@KDE_INSTALL_FULL_BINDIR@/plasma-label-creator-automation
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
